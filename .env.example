# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.
#
# Vercel: add the same names/values under Project Settings → Environment
# Variables so the deployed app has them too (local .env.local is NOT
# picked up by a Vercel deployment, only by `vercel dev` locally).

# Required for any real AI call (TL;DR, and later song lyrics / kid mode).
# Free, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-3.6-flash if unset.
# GEMINI_MODEL=gemini-3.6-flash

# Only needed once Song mode's real audio (lib/elevenlabs.js) is wired up.
# Requires a paid ElevenLabs plan — the Music API isn't on the free tier.
# https://elevenlabs.io
ELEVENLABS_API_KEY=
