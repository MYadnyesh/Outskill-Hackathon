# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.
#
# Vercel: add the same names/values under Project Settings → Environment
# Variables so the deployed app has them too (local .env.local is NOT
# picked up by a Vercel deployment, only by `vercel dev` locally).

# Required for any real AI call (TL;DR summaries, song lyrics, and later kid mode).
# Free, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# IMPORTANT: the free tier allows only 20 generate_content requests per day
# PER MODEL. lib/gemini.js therefore keeps a priority list and automatically
# falls back to the next model on 429 (quota), 404 (retired) or 503 (overloaded),
# so each fallback buys another 20/day. You usually don't need to set either
# of these — the defaults already chain 5 models.
#
# Optional — override just the preferred model; the rest of the built-in list
# stays available as fallbacks behind it.
# GEMINI_MODEL=gemini-3.6-flash
#
# Optional — replace the whole priority list (comma-separated, first = preferred).
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.7-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite

# Optional — Song mode's real audio (lib/elevenlabs.js). Requires a PAID
# ElevenLabs plan; the Music API isn't on the free tier. https://elevenlabs.io
# Leave this blank and Song mode still works: lyrics are generated as normal
# and the player falls back to simulated playback (audioUrl: null).
ELEVENLABS_API_KEY=

# Optional — defaults to music_v2 if unset.
# ELEVENLABS_MUSIC_MODEL=music_v2
